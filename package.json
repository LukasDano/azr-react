{
    "name": "azr-react",
    "version": "0.0.9",
    "private": true,
    "homepage": "https://LukasDano.github.io/azr-react",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run tsc && vite build",
        "preview": "vite preview",
        "tsc": "tsc -b",
        "vitest:all": "npm run vitest:component && npm run vitest:function",
        "vitest:component": "npx vitest run test/component --reporter=verbose",
        "vitest:function": "npx vitest run test/function --reporter=verbose",
        "ox:lint": "oxlint",
        "ox:lint:fix": "oxlint --fix",
        "ox:fmt": "oxfmt",
        "ox:fmt:check": "oxfmt --check",
        "local:ci": "npm run tsc && npm run ox:fmt:check && npm run ox:lint && npm run vitest:all",
        "prepare-commit": "npm run tsc && npm run ox:fmt && npm run ox:lint:fix && npm run vitest:all",
        "build-with-qs": "npm run prepare-commit && npm run build",
        "deploy": "npm run build-with-qs && vpm.exe deploy",
        "update:dependencies": "vpm.exe outdated && npm run ox:fmt"
    },
    "dependencies": {
        "@tanstack/react-hotkeys": "^0.10.0",
        "@tanstack/react-query": "^5.101.4",
        "@tippyjs/react": "^4.2.6",
        "@uiw/react-color": "^2.10.3",
        "lucide-react": "^1.27.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-icons": "^5.7.0",
        "react-select": "^5.10.2",
        "react-spinners": "^0.17.0",
        "react-toastify": "^11.1.0",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.16",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "babel-plugin-react-compiler": "^1.0.0",
        "jsdom": "^29.1.1",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "oxlint-tsgolint": "^7.0.2001",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    }
}
