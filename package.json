{
    "name": "azr-react",
    "version": "0.0.5",
    "private": true,
    "homepage": "https://LukasDano.github.io/azr-react",
    "type": "module",
    "scripts": {
        "biome:check": "biome check --write",
        "biome:ci": "biome ci",
        "biome:format": "biome format --write",
        "biome:lint:ci": "biome lint --write",
        "build": "tsc -b && vite build",
        "dev": "vite",
        "local:ci": "npm run tsc && npm run biome:ci && npm run vitest:all",
        "prepare-commit": "npm run tsc && npm run sort-package && npm run biome:check && npm run vitest:all",
        "preview": "vite preview",
        "sort-package": "sort-package-json",
        "tsc": "tsc -b",
        "vitest:all": "npm run vitest:component && npm run vitest:function",
        "vitest:component": "npx vitest run test/component --reporter=verbose",
        "vitest:function": "npx vitest run test/function --reporter=verbose"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.10",
        "@tippyjs/react": "^4.2.6",
        "@uiw/react-color": "^2.10.3",
        "lucide-react": "^1.17.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-icons": "^5.6.0",
        "react-select": "^5.10.2",
        "react-spinners": "^0.17.0",
        "sonner": "^2.0.7",
        "tailwindcss": "^4.3.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.16",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss/vite": "^4.3.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "jsdom": "^29.1.1",
        "sort-package-json": "^3.6.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vitest": "^4.1.8"
    }
}
