{
    "name": "azr-react",
    "private": true,
    "version": "0.0.2",
    "homepage": "https://LukasDano.github.io/azr-react",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "tsc": "tsc -b",
        "biome:check": "biome check --write",
        "biome:lint:ci": "biome lint --write",
        "biome:format": "biome format --write",
        "biome:ci": "biome ci",
        "vitest:all": "npm run vitest:component && npm run vitest:function",
        "vitest:component": "npx vitest run test/component --reporter=verbose",
        "vitest:function": "npx vitest run test/function --reporter=verbose",
        "local:ci": "npm run tsc && npm run biome:ci && npm run vitest:all",
        "prepare-commit": "npm run tsc && npm run biome:check && npm run vitest:all"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.9",
        "@tailwindcss/vite": "^4.1.18",
        "@tippyjs/react": "^4.2.6",
        "@uiw/react-color": "^2.9.4",
        "lucide-react": "^0.563.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-icons": "^5.5.0",
        "react-select": "^5.10.2",
        "sonner": "^2.0.7",
        "tailwindcss": "^4.1.18"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.14",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react-swc": "^4.2.2",
        "jsdom": "^27.4.0",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.0.18"
    }
}
