{
    "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false
    },
    "linter": {
        "enabled": true,
        "includes": ["**/*.{ts,tsx}"],
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noUnusedVariables": "warn",
                "useValidForDirection": "error",
                "useExhaustiveDependencies": "off"
            },
            "style": {
                "noDefaultExport": "error",
                "useConst": "error",
                "useImportType": "error",
                "useTemplate": "warn",
                "noNonNullAssertion": "off",
                "noYodaExpression": "error"
            },
            "suspicious": {
                "noExplicitAny": "off",
                "noDocumentCookie": "off"
            },
            "a11y": {
                "useButtonType": "off",
                "noStaticElementInteractions": "off",
                "noLabelWithoutControl": "off",
                "useKeyWithClickEvents": "off"
            },
            "security": {
                "noBlankTarget": "error"
            },
            "nursery": {
                "useSortedClasses": {
                    "level": "error",
                    "fix": "safe"
                },
                "useExplicitReturnType": {
                    "level": "error",
                    "options": {
                        "allowIifes": true,
                        "allowExpressions": true
                    }
                }
            }
        }
    },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "auto",
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "es5",
            "trailingNewline": true
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": {
                    "level": "on",
                    "options": {
                        "groups": [":PACKAGE:", ":BLANK_LINE:", ["./**"]]
                    }
                }
            }
        }
    }
}
